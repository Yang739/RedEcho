.page { padding: 28rpx 28rpx 60rpx; }

/* 品牌头部 */
.brand {
  display: flex; flex-direction: column; align-items: center;
  padding: 48rpx 0 40rpx;
}
.brand__logo {
  width: 128rpx; height: 128rpx; border-radius: 50%;
  background: linear-gradient(135deg, var(--c-primary), var(--c-primary-dark));
  color: #fff; font-size: 60rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--s-2);
  margin-bottom: 24rpx;
}
.brand__name { font-size: 44rpx; font-weight: 800; letter-spacing: 2rpx; }
.brand__en {
  font-size: 24rpx; letter-spacing: 6rpx; color: var(--c-text-3);
  margin-top: 6rpx;
}
.brand__tag {
  margin-top: 16rpx; font-size: 24rpx; color: var(--c-primary);
  background: var(--c-primary-light); padding: 8rpx 24rpx; border-radius: var(--r-pill);
}

/* 简介 */
.intro { margin-top: 12rpx; }
.intro__title {
  font-size: 30rpx; font-weight: 700; color: var(--c-primary);
  margin-bottom: 14rpx; padding-left: 18rpx; position: relative;
}
.intro__title::before {
  content: ''; position: absolute; left: 0; top: 6rpx; bottom: 6rpx;
  width: 6rpx; border-radius: 3rpx; background: var(--c-primary);
}
.intro__text { font-size: 28rpx; line-height: 1.75; color: var(--c-text-2); }

/* 核心功能 */
.features { padding: 12rpx 28rpx; }
.feature {
  display: flex; align-items: flex-start; gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--c-divider);
}
.feature:last-child { border-bottom: none; }
.feature__icon {
  flex: none; width: 72rpx; height: 72rpx; border-radius: 50%;
  background: var(--c-accent-light); color: var(--c-accent);
  font-size: 34rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
}
.feature__title { font-size: 30rpx; font-weight: 700; }
.feature__desc {
  margin-top: 8rpx; font-size: 25rpx; line-height: 1.65; color: var(--c-text-2);
}

/* 版本与版权 */
.footer { margin-top: 48rpx; text-align: center; }
.footer__ver { font-size: 24rpx; color: var(--c-text-2); }
.footer__copy { margin-top: 8rpx; font-size: 22rpx; color: var(--c-text-3); }
