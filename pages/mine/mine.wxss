.page { padding: 20rpx 28rpx calc(120rpx + env(safe-area-inset-bottom)); }

.profile {
  display: flex; align-items: center; gap: 24rpx;
  padding: 40rpx 32rpx; border-radius: var(--r-lg);
  background:
    radial-gradient(120% 120% at 85% 0%, rgba(255,255,255,.14), transparent 60%),
    linear-gradient(135deg, #C8161D 0%, #7A0A10 100%);
  color: #fff; box-shadow: var(--s-2);
}
.profile__avatar {
  width: 104rpx; height: 104rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,.2); font-size: 42rpx; font-weight: 800;
  border: 3rpx solid rgba(255,255,255,.4);
  overflow: hidden;
}
.profile__img { width: 100%; height: 100%; border-radius: 50%; }
.profile__name { font-size: 36rpx; font-weight: 800; margin-bottom: 12rpx; }
.profile__sign { font-size: 24rpx; opacity: .9; margin-bottom: 12rpx; line-height: 1.4; }

.points {
  display: flex; align-items: center;
  margin-top: 24rpx; padding: 32rpx;
  background: var(--c-surface); border-radius: var(--r-md);
  box-shadow: var(--s-1);
}
.points__col { flex: 1; text-align: center; }
.points__num { font-size: 44rpx; font-weight: 800; color: var(--c-primary); }
.points__label { font-size: 22rpx; color: var(--c-text-2); margin-top: 4rpx; }
.points__divider { width: 1rpx; height: 60rpx; background: var(--c-divider); }
.points__cta { color: var(--c-primary); font-weight: 700; padding-left: 20rpx; }

.stats {
  display: flex; margin-top: 20rpx;
  background: var(--c-surface); border-radius: var(--r-md);
  box-shadow: var(--s-1); padding: 28rpx 0;
}
.stats__item { flex: 1; text-align: center; }
.stats__num { font-size: 36rpx; font-weight: 800; }
.stats__label { margin-top: 6rpx; }

.menu { display: flex; flex-direction: column; }
.menu__item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 26rpx 4rpx;
}
.menu__item + .menu__item { border-top: 1rpx solid var(--c-divider); }
.menu__name { font-size: 30rpx; font-weight: 500; }
.menu__arrow { color: var(--c-text-3); font-size: 36rpx; }

.footer-tip { text-align: center; padding: 40rpx 0 20rpx; }
