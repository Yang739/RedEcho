<view class="page">
  <!-- 个人信息 -->
  <view class="profile bg-grid fade-up">
    <view class="profile__avatar">{{user.avatarText}}</view>
    <view class="flex-1">
      <view class="profile__name">{{user.nickname}}</view>
      <re-tag type="accent" solid>{{user.level}}</re-tag>
    </view>
  </view>

  <!-- 积分 -->
  <view class="points tap" bindtap="onPoints">
    <view class="points__col">
      <view class="points__num">{{points}}</view>
      <view class="points__label">当前积分</view>
    </view>
    <view class="points__divider"></view>
    <view class="points__col">
      <view class="points__num">{{todayGain}}</view>
      <view class="points__label">今日获得</view>
    </view>
    <view class="points__cta">明细 ›</view>
  </view>

  <!-- 数据统计 -->
  <view class="stats">
    <view
      class="stats__item tap"
      wx:for="{{statsList}}"
      wx:key="key"
      bindtap="onStat"
      data-key="{{item.key}}"
    >
      <view class="stats__num">{{item.value}}</view>
      <view class="stats__label text-3 xs">{{item.label}}</view>
    </view>
  </view>

  <!-- 我的阅读 -->
  <re-card title="我的阅读">
    <view class="read-head">
      <text class="read-count text-3 xs">已读 {{readCount}} 篇</text>
      <text wx:if="{{readList.length}}" class="read-clear" bindtap="onClearRead">清空</text>
    </view>
    <view wx:if="{{readList.length}}" class="read-list">
      <view
        class="read-item tap"
        wx:for="{{readList}}"
        wx:key="id"
        bindtap="onReadTap"
        data-id="{{item.id}}"
      >
        <view class="read-item__bar" style="background:{{item.gradient}}"></view>
        <view class="read-item__main">
          <view class="read-item__title">{{item.title}}</view>
          <view class="read-item__sub text-3 xs">{{item.catName}} · 约 {{item.minutes}} 分钟</view>
        </view>
        <text class="read-item__arrow">›</text>
      </view>
    </view>
    <view wx:else class="read-empty text-3 xs">还没有阅读记录，去首页看看资料卡片吧</view>
  </re-card>

  <!-- 服务菜单 -->
  <re-card title="我的服务">
    <view class="menu">
      <view
        class="menu__item tap"
        wx:for="{{menus}}"
        wx:key="key"
        bindtap="onMenu"
        data-key="{{item.key}}"
      >
        <text class="menu__name">{{item.name}}</text>
        <text class="menu__arrow">›</text>
      </view>
    </view>
  </re-card>

  <view class="footer-tip text-3 xs">红色回响 · 红色旧址沉浸式互动演出</view>
</view>
