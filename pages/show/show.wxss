.page { padding: 20rpx 28rpx 60rpx; }

/* 分段控件 */
.seg {
  display: flex; gap: 8rpx;
  background: var(--c-surface);
  padding: 8rpx;
  border-radius: var(--r-pill);
  box-shadow: var(--s-1);
  position: sticky; top: 0; z-index: 5;
}
.seg__item {
  flex: 1; text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx; font-weight: 600;
  color: var(--c-text-2);
  border-radius: var(--r-pill);
  transition: all .2s cubic-bezier(.16,1,.3,1);
}
.seg__item--active {
  background: var(--c-primary);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(200,22,29,.28);
}

/* 演出卡片 */
.show {
  display: flex; gap: 22rpx;
  background: var(--c-surface);
  border-radius: var(--r-md);
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--s-1);
}
.show__cover {
  position: relative;
  width: 200rpx; height: 150rpx; flex-shrink: 0;
  border-radius: var(--r-sm); overflow: hidden;
}
.show__body { display: flex; flex-direction: column; }
.show__title { font-size: 30rpx; font-weight: 700; }
.show__venue { margin-top: 6rpx; }
.show__foot { margin-top: auto; padding-top: 12rpx; }
