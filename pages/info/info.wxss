.page { padding: 24rpx; min-height: 100vh; background: #f5f5f5; box-sizing: border-box; }

.form-row {
  display: flex; align-items: center; gap: 20rpx;
  padding: 24rpx 4rpx;
}
.form-row + .form-row { border-top: 1rpx solid var(--c-divider); }
.form-row--top { align-items: stretch; flex-direction: column; gap: 12rpx; }

.form-label { width: 150rpx; font-size: 30rpx; color: #222; flex: none; }
.form-row--top .form-label { width: auto; }

.form-input { flex: 1; font-size: 30rpx; color: #222; text-align: right; }

.form-textarea {
  width: 100%; font-size: 28rpx; color: #222; text-align: left;
  min-height: 96rpx; line-height: 1.4;
}

.form-picker { flex: 1; }
.form-picker__val { text-align: right; font-size: 30rpx; color: var(--c-text-2); }

.form-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 30rpx; flex: none; overflow: hidden;
}
.form-avatar__img { width: 100%; height: 100%; border-radius: 50%; }

.pf-save { margin-top: 32rpx; }
