<view class="page">
  <view class="pv-head">
    <view class="pv-title">隐私政策</view>
    <view class="pv-updated">更新于 {{updated}}</view>
  </view>

  <view class="card pv-sec" wx:for="{{sections}}" wx:key="h">
    <view class="pv-h">{{item.h}}</view>
    <view class="pv-p">{{item.p}}</view>
  </view>

  <view class="tip">本政策为演示文本，正式上线前请以法务核定版本为准。</view>
</view>
