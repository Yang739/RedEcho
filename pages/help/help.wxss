.page { padding: 24rpx; min-height: 100vh; background: var(--c-bg); box-sizing: border-box; }

.faq { margin-bottom: 20rpx; border-radius: var(--r-md); box-shadow: var(--s-1); }

.faq__q {
  display: flex; align-items: center;
  padding: 28rpx 8rpx;
}
.faq__mark {
  width: 40rpx; height: 40rpx; margin-right: 16rpx;
  border-radius: 50%;
  background: var(--c-primary-light); color: var(--c-primary);
  font-size: 26rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.faq__title { flex: 1; font-size: 30rpx; color: var(--c-text); font-weight: 600; }
.faq__arrow { font-size: 40rpx; color: var(--c-text-3); line-height: 1; margin-left: 12rpx; }

.faq__a {
  padding: 0 8rpx 28rpx 64rpx;
  font-size: 27rpx; color: var(--c-text-2); line-height: 1.7;
}

.tip { padding: 24rpx 8rpx; line-height: 1.7; }
