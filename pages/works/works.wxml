<import src="../../templates/pc-card.wxml" />

<view class="page">
  <view class="section-title">我的作品</view>

  <re-card wx:if="{{!list.length}}" title="暂无作品">
    <view class="empty">还没有作品，去「创作」页生成第一张红色明信片吧</view>
  </re-card>

  <view wx:else class="works">
    <view
      class="pc-card-wrap tap"
      wx:for="{{list}}"
      wx:key="id"
      bindtap="onPreview"
      data-id="{{item.id}}"
      bindlongpress="onDeleteList"
      data-id="{{item.id}}"
    >
      <template is="pcCard" data="{{ card: item }}" />
    </view>
  </view>

  <view style="height:40rpx"></view>

  <!-- 作品预览（点空白处关闭；仅 保存 / 分享 / 打印） -->
  <view wx:if="{{preview}}" class="preview-mask" bindtap="onClosePreview">
    <view class="preview-card" catchtap="noop">
      <template is="pcCard" data="{{ card: preview }}" />
      <view class="preview-actions">
        <view class="btn btn-primary flex-1 tap" bindtap="onSaveFromPreview">保存</view>
        <button class="btn btn-ghost flex-1 tap preview-share" open-type="share">分享</button>
        <view class="btn btn-ghost flex-1 tap" bindtap="onPrint">打印</view>
      </view>
    </view>
    <canvas type="2d" id="pcCanvas" class="pc-canvas"></canvas>
  </view>
</view>
