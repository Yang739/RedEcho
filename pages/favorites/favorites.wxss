.page { padding: 20rpx 28rpx 60rpx; }

/* 阅读收藏 */
.read-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 12rpx;
}
.read-clear { font-size: 24rpx; color: var(--c-primary, #C8161D); }
.read-list { display: flex; flex-direction: column; }
.read-item-wrap {
  position: relative;
  overflow: hidden;
}
.read-item-wrap + .read-item-wrap { border-top: 1rpx solid var(--c-divider, #eee); }
.read-item__del {
  position: absolute; top: 0; right: 0; bottom: 0;
  width: 72px;
  display: flex; align-items: center; justify-content: center;
  background: #9e9e9e; color: #fff; font-size: 28rpx;
}
.read-item {
  position: relative; z-index: 2;
  display: flex; align-items: center; gap: 20rpx;
  padding: 20rpx 4rpx;
  background: var(--c-bg, #fff);
}
.read-item.anim { transition: transform .25s ease; }
.read-item__bar {
  width: 8rpx; height: 64rpx; border-radius: 999rpx; flex-shrink: 0;
}
.read-item__main { flex: 1; min-width: 0; }
.read-item__title {
  font-size: 30rpx; font-weight: 600; color: var(--c-text-1, #333);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.read-item__sub { margin-top: 6rpx; }
.read-empty { padding: 24rpx 4rpx; line-height: 1.6; }

.footer-tip { text-align: center; padding: 40rpx 0 20rpx; }
