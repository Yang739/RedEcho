<view class="page">
  <re-card title="阅读收藏">
    <view class="read-head">
      <text class="read-count text-3 xs">已收藏 {{count}} 篇</text>
      <text wx:if="{{list.length}}" class="read-clear" bindtap="onClear">清空</text>
    </view>
    <view wx:if="{{list.length}}" class="read-list">
      <view class="read-item-wrap" wx:for="{{list}}" wx:key="id">
        <view class="read-item__del" catchtap="onDelete" data-id="{{item.id}}">删除</view>
        <view
          class="read-item tap {{item.anim ? 'anim' : ''}}"
          style="transform: translateX({{item.offset || 0}}px);"
          data-id="{{item.id}}"
          bindtouchstart="onSwipeStart"
          bindtouchmove="onSwipeMove"
          bindtouchend="onSwipeEnd"
          bindtap="onRead"
        >
          <view class="read-item__bar" style="background:{{item.gradient}}"></view>
          <view class="read-item__main">
            <view class="read-item__title">{{item.title}}</view>
            <view class="read-item__sub text-3 xs">{{item.catName}} · {{item.subtitle}}</view>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="read-empty text-3 xs">还没有收藏，去资料详情页点「收藏」吧</view>
  </re-card>

  <view class="footer-tip text-3 xs">红韵智演 · 红色旧址沉浸式互动演出</view>
</view>
