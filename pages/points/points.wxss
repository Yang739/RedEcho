.page {
  padding: 24rpx 24rpx 60rpx;
  min-height: 100vh;
  background: #f5f5f5;
  box-sizing: border-box;
}

/* 头部 */
.hd {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #C8161D 0%, #7A0A10 100%);
  border-radius: 20rpx;
  padding: 40rpx 0;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(200, 22, 29, 0.25);
}
.hd__col { flex: 1; text-align: center; }
.hd__num { font-size: 52rpx; font-weight: 700; line-height: 1.1; }
.hd__label { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }
.hd__divider { width: 1rpx; height: 64rpx; background: rgba(255, 255, 255, 0.3); }

/* 列表 */
.list { margin-top: 28rpx; }
.group__title { font-size: 24rpx; color: #999; margin: 24rpx 8rpx 12rpx; }

.item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.item__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #888;
}
.item__icon--read { background: #C8161D; }
.item__icon--show { background: #E8A33D; }
.item__icon--postcard { background: #7A0A10; }
.item__icon--redeem { background: #2B7A78; }
.item__icon--adjust { background: #888; }
.item__body { flex: 1; min-width: 0; }
.item__title { font-size: 30rpx; color: #222; }
.item__time { margin-top: 6rpx; }
.item__delta { font-size: 32rpx; font-weight: 700; margin-left: 16rpx; flex-shrink: 0; }
.item__delta.is-plus { color: #C8161D; }
.item__delta.is-minus { color: #666; }

/* 空态 */
.empty { text-align: center; padding: 120rpx 40rpx; }
.empty__icon {
  width: 96rpx; height: 96rpx; line-height: 96rpx;
  border-radius: 50%; background: #eee; color: #bbb;
  font-size: 40rpx; margin: 0 auto;
}
.empty__text { font-size: 30rpx; color: #666; margin-top: 24rpx; }
.empty__sub { margin-top: 12rpx; padding: 0 40rpx; line-height: 1.6; }
