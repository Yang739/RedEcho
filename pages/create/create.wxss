.page { padding: 20rpx 28rpx 60rpx; }

.intro {
  padding: 36rpx 32rpx; border-radius: var(--r-lg);
  background:
    radial-gradient(120% 120% at 85% 0%, rgba(255,255,255,.12), transparent 60%),
    linear-gradient(135deg, #9E0B11 0%, #C8161D 100%);
  color: #fff; box-shadow: var(--s-2); margin-bottom: 8rpx;
}
.intro__title { font-size: 38rpx; font-weight: 800; }
.intro__desc { font-size: 25rpx; opacity: .88; margin-top: 10rpx; line-height: 1.6; }

/* 生成明信片主入口 */
.cta-row { margin: 20rpx 0 4rpx; }

/* 场景网格 */
.scenes { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.scene { background: var(--c-surface); border-radius: var(--r-md); overflow: hidden; box-shadow: var(--s-1); }
.scene__cover {
  position: relative; height: 200rpx;
  display: flex; align-items: flex-end; justify-content: flex-end;
  padding: 16rpx;
}
.scene__go {
  background: rgba(0,0,0,.35); color: #fff; font-size: 22rpx;
  padding: 6rpx 18rpx; border-radius: var(--r-pill);
}
.scene__name { font-size: 28rpx; font-weight: 700; padding: 16rpx 20rpx 4rpx; }
.scene__desc { padding: 0 20rpx 20rpx; }

/* 作品画廊 */
.gallery { white-space: nowrap; margin-top: 8rpx; }
.pc {
  display: inline-flex; flex-direction: column; justify-content: space-between;
  width: 280rpx; height: 380rpx; padding: 28rpx;
  border-radius: var(--r-md); margin-right: 20rpx; color: #fff;
  box-shadow: var(--s-1); vertical-align: top;
  text-align: left;
}
.pc--center { text-align: center; align-items: center; }
.pc--minimal { text-align: right; align-items: flex-end; }
.pc__scene { font-size: 30rpx; font-weight: 800; }
.pc__quote { font-size: 27rpx; line-height: 1.6; font-style: italic; }
.pc__date { font-size: 20rpx; opacity: .8; }

/* 预览层 */
.preview-mask {
  position: fixed; inset: 0; z-index: 60;
  background: rgba(0,0,0,.6);
  display: flex; align-items: center; justify-content: center;
  padding: 40rpx;
}
.preview-card { width: 100%; max-width: 620rpx; }
.pc-card {
  height: 760rpx; border-radius: var(--r-lg);
  box-shadow: var(--s-2); overflow: hidden; background: var(--c-surface-2);
}
.pc-card__img { width: 100%; height: 100%; display: block; }
.pc-card__inner {
  height: 100%; padding: 48rpx 40rpx;
  display: flex; flex-direction: column; justify-content: space-between; color: #fff;
}
.pc-card__scene { font-size: 40rpx; font-weight: 800; letter-spacing: 1rpx; }
.pc-card__quote { font-size: 38rpx; line-height: 1.7; font-style: italic; font-weight: 600; }
.pc-card__date { font-size: 24rpx; opacity: .85; }
.pc-card__inner--center { text-align: center; align-items: center; }
.pc-card__inner--minimal { text-align: right; align-items: flex-end; }

.preview-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.preview-actions .btn { flex: 1; text-align: center; font-size: 28rpx; }
.preview-share { line-height: 1; padding: 0; margin: 0; }
.preview-share::after { border: none; }

/* 离屏画布 */
.pc-canvas { position: fixed; left: -9999rpx; top: -9999rpx; width: 600px; height: 800px; }
