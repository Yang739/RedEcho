.page { padding: 20rpx 28rpx calc(120rpx + env(safe-area-inset-bottom)); min-height: 100vh; box-sizing: border-box; }

/* 创作红色记忆：Hero 风格入口卡片，参考首页「你好，旅人」 */
.intro {
  margin: 20rpx 0 8rpx;
  padding: 36rpx 32rpx;
  border-radius: var(--r-lg);
  background:
    radial-gradient(120% 120% at 80% 0%, rgba(255,255,255,.12), transparent 60%),
    linear-gradient(135deg, #C8161D 0%, #7A0A10 100%);
  color: #fff; box-shadow: var(--s-2);
  display: flex; align-items: center; justify-content: space-between;
}
.intro__main { flex: 1; min-width: 0; }
.intro__title { font-size: 38rpx; font-weight: 800; }
.intro__desc { font-size: 25rpx; opacity: .88; margin-top: 10rpx; line-height: 1.6; }

.more-link { font-size: 24rpx; color: var(--c-primary); font-weight: 600; }

/* 作品画廊：两列等宽由共享 .pc-grid 提供；此处仅保留上间距 */
.works-grid { margin-top: 8rpx; }
/* 画廊卡片外观统一由 app.wxss .pc-cell / .pc-frame 提供 */

/* 空态：白色卡片，与截图一致；文字左上角对齐 */
.empty-card {
  margin-top: 8rpx;
  padding: 72rpx 36rpx;
  min-height: 220rpx;
  background: #fff;
  border-radius: var(--r-lg);
  box-shadow: var(--s-2);
  display: flex;
  flex-direction: column;
}
.empty-card__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--c-text);
  line-height: 1.4;
}
.empty-card__subtitle {
  font-size: 26rpx;
  color: var(--c-text-3);
  line-height: 1.6;
  margin-top: 16rpx;
  text-align: center;
}

/* 预览层 */
.preview-mask {
  position: fixed; inset: 0; z-index: 60;
  background: rgba(0,0,0,.6);
  display: flex; align-items: center; justify-content: center;
  padding: 40rpx;
}
.preview-card {
  width: 100%;
  max-width: 560rpx;
  max-height: calc(100vh - 120rpx);
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.preview-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.preview-actions .btn { flex: 1; text-align: center; font-size: 28rpx; }
.preview-share { line-height: 1; padding: 0; margin: 0; }
.preview-share::after { border: none; }

/* 离屏画布 */
.pc-canvas { position: fixed; left: -9999rpx; top: -9999rpx; width: 900px; height: 600px; }
