<import src="../../templates/pc-card.wxml" />

<view class="page">
  <!-- 引导 + 入口：整张卡片即入口（场景选择在生成页内） -->
  <view class="intro bg-grid fade-up tap" bindtap="onStartCreate">
    <view class="intro__main">
      <view class="intro__title">创作红色记忆</view>
      <view class="intro__desc">选择一处旧址场景，AI 为你生成专属金句明信片，带走这份信仰的温度。</view>
    </view>
  </view>

  <!-- 我的作品 -->
  <view class="section-title between">
    <text>我的作品</text>
    <view wx:if="{{hasWorks}}" class="more-link tap" bindtap="onAll">全部 ›</view>
  </view>
  <re-card wx:if="{{!postcards.length && !loading}}" title="暂无作品">
    <view class="empty">生成第一张明信片，记录你的红色足迹</view>
  </re-card>
  <view wx:else class="works-grid">
    <view
      class="pc-frame tap"
      wx:for="{{postcards}}"
      wx:key="id"
      bindtap="onPreview"
      data-id="{{item.id}}"
    >
      <template is="pcCard" data="{{ card: item }}" />
    </view>
  </view>

  <view style="height:40rpx"></view>

  <!-- 作品预览（点空白处关闭） -->
  <view wx:if="{{preview}}" class="preview-mask" bindtap="onClosePreview">
    <view class="preview-card" catchtap="noop">
      <view class="pc-frame">
        <template is="pcCard" data="{{ card: preview }}" />
      </view>
      <view class="preview-actions">
        <view class="btn btn-primary flex-1 tap" bindtap="onSaveFromPreview">保存</view>
        <button class="btn btn-ghost flex-1 tap preview-share" open-type="share">分享</button>
        <view class="btn btn-ghost flex-1 tap" bindtap="onPrint">打印</view>
      </view>
    </view>
    <canvas type="2d" id="pcCanvas" class="pc-canvas"></canvas>
  </view>
</view>
