<view class="page">
  <!-- 引导 -->
  <view class="intro bg-grid fade-up">
    <view class="intro__title">创作红色记忆</view>
    <view class="intro__desc">选择一处旧址场景，AI 为你生成专属金句明信片，带走这份信仰的温度。</view>
  </view>

  <!-- 快捷入口：生成明信片主按钮 -->
  <view class="cta-row">
    <view class="btn btn-primary btn-block tap" bindtap="onStartCreate">生成明信片</view>
  </view>

  <!-- 场景选择 -->
  <view class="section-title">选择场景</view>
  <block wx:if="{{loading}}">
    <view class="scenes">
      <view class="scene" wx:for="{{[1,2,3,4]}}" wx:key="*this">
        <view class="scene__cover skeleton"></view>
      </view>
    </view>
  </block>
  <view class="scenes" wx:else>
    <view
      class="scene tap"
      wx:for="{{scenes}}"
      wx:key="id"
      bindtap="onSelect"
      data-id="{{item.id}}"
    >
      <view class="scene__cover" style="background:{{item.gradient}}">
        <text class="scene__go">生成 ›</text>
      </view>
      <view class="scene__name">{{item.name}}</view>
      <view class="scene__desc text-3 xs ellipsis">{{item.desc}}</view>
    </view>
  </view>

  <!-- 我的作品 -->
  <view class="section-title">我的作品</view>
  <re-card wx:if="{{!postcards.length && !loading}}" title="暂无作品">
    <view class="empty">生成第一张明信片，记录你的红色足迹</view>
  </re-card>
  <scroll-view wx:else scroll-x class="gallery" enhanced show-scrollbar="{{false}}">
    <view
      class="pc tap pc--{{item.layout || 'classic'}}"
      wx:for="{{postcards}}"
      wx:key="id"
      style="background:{{item.gradient}}"
      bindtap="onPreview"
      data-id="{{item.id}}"
    >
      <view class="pc__scene">{{item.scene}}</view>
      <view class="pc__quote">“{{item.quote}}”</view>
      <view class="pc__date">{{item.date}}</view>
    </view>
  </scroll-view>

  <view style="height:40rpx"></view>

  <!-- 作品预览 -->
  <view wx:if="{{preview}}" class="preview-mask" bindtap="onClosePreview">
    <view class="preview-card" catchtap="noop">
      <view class="pc-card">
        <image wx:if="{{preview.imageUrl}}" class="pc-card__img" src="{{preview.imageUrl}}" mode="aspectFill" />
        <view wx:else class="pc-card__inner pc-card__inner--{{preview.layout || 'classic'}}" style="background:{{preview.gradient}};height:100%">
          <view class="pc-card__scene">{{preview.scene}}</view>
          <view class="pc-card__quote">“{{preview.quote}}”</view>
          <view class="pc-card__date">{{preview.date}} · 红色回响</view>
        </view>
      </view>
      <view class="preview-actions">
        <view class="btn btn-primary tap" bindtap="onSaveFromPreview">保存相册</view>
        <button class="btn btn-ghost tap preview-share" open-type="share">转发给好友</button>
        <view class="btn btn-ghost tap" bindtap="onClosePreview">关闭</view>
      </view>
    </view>
    <!-- 离屏画布：用于从历史记录现绘保存（透明不占视觉） -->
    <canvas type="2d" id="pcCanvas" class="pc-canvas"></canvas>
  </view>
</view>
