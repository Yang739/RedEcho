<view class="page">
  <!-- 引导 + 入口：整张卡片即入口（场景选择在生成页内） -->
  <view class="intro bg-grid fade-up tap" bindtap="onStartCreate">
    <view class="intro__main">
      <view class="intro__title">创作红色记忆</view>
      <view class="intro__desc">选择一处旧址场景，AI 为你生成专属金句明信片，带走这份信仰的温度。</view>
    </view>
  </view>

  <!-- 我的作品 -->
  <view class="section-title between">
    <text>我的作品</text>
    <!-- 始终可跳转到作品中心（即便暂无作品也能进入查看/核对），避免"全部"入口随空态一起消失 -->
    <view class="more-link tap" bindtap="onAll">全部 ›</view>
  </view>

  <!-- 无作品：白色卡片空态 -->
  <view wx:if="{{!postcards.length && !loading}}" class="empty-card tap" bindtap="onStartCreate">
    <text class="empty-card__title">暂无作品</text>
    <text class="empty-card__subtitle">生成第一张明信片，记录你的红色足迹</text>
  </view>

  <!-- 有作品：画廊 -->
  <view wx:else class="works-grid pc-grid">
    <view
      class="pc-cell tap"
      wx:for="{{postcards}}"
      wx:key="id"
      bindtap="onPreview"
      bindlongpress="onDeleteWork"
      data-id="{{item.id}}"
    >
      <view class="pc-frame pc-frame--{{item.orient}}">
        <pc-canvas card="{{item}}" />
      </view>
    </view>
  </view>

  <view style="height:40rpx"></view>

  <!-- 作品预览（点空白处关闭）。预览打开时仅隐藏底部 tabBar，画廊 canvas 保留在 DOM。
       catchtouchmove 锁定背景滚动，预览图不再随页面滑动、不露白底。 -->
  <view wx:if="{{preview}}" class="preview-mask" bindtap="onClosePreview" catchtouchmove="noop">
    <view class="preview-card" catchtap="noop">
      <view class="pc-frame pc-frame--{{preview.orient}}">
        <pc-canvas card="{{preview}}" res="900" />
      </view>
      <view class="preview-actions">
        <view class="btn btn-ghost flex-1 tap" bindtap="onSaveFromPreview">保存</view>
        <button class="btn btn-ghost flex-1 tap preview-share" open-type="share">分享</button>
        <view class="btn btn-ghost flex-1 tap" bindtap="onPrint">打印</view>
      </view>
    </view>
    <canvas type="2d" id="pcCanvas" class="pc-canvas"></canvas>
  </view>
</view>
