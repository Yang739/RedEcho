<view class="page">
  <!-- 分类筛选 -->
  <scroll-view class="cat-bar" scroll-x="true">
    <view
      class="cat {{activeCat === item.key ? 'cat--on' : ''}}"
      wx:for="{{categories}}"
      wx:key="key"
      bindtap="onCat"
      data-cat="{{item.key}}"
    >{{item.name}}</view>
  </scroll-view>

  <!-- 资料列表 -->
  <view class="list">
    <view
      class="rec tap"
      wx:for="{{list}}"
      wx:key="id"
      bindtap="onRead"
      data-id="{{item.id}}"
    >
      <view class="rec__cover" style="background:{{item.gradient}}">
        <text class="rec__cover-era">{{item.era}}</text>
        <text class="rec__cover-tag">{{item.tag}}</text>
      </view>
      <view class="rec__body flex-1">
        <view class="rec__title ellipsis">{{item.title}}</view>
        <view class="rec__sub text-3 sm">{{item.subtitle}}</view>
        <view class="rec__desc text-2 sm ellipsis-2">{{item.desc}}</view>
        <view class="rec__meta">
          <re-tag type="{{item.read ? 'success' : 'primary'}}">{{item.read ? '已读' : item.minutes + ' 分钟'}}</re-tag>
        </view>
      </view>
    </view>
    <view wx:if="{{!list.length}}" class="empty">该分类暂无资料</view>
  </view>
</view>
