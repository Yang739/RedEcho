.page { min-height: 100vh; background: var(--c-bg, #f5f5f5); }

/* 头图 */
.hero {
  padding: 48rpx 36rpx 56rpx;
  color: #fff;
}
.hero__era { font-size: 40rpx; font-weight: 800; opacity: .82; }
.hero__title { font-size: 48rpx; font-weight: 800; margin-top: 10rpx; line-height: 1.25; }
.hero__sub { font-size: 26rpx; opacity: .85; margin-top: 14rpx; }
.hero__tag {
  display: inline-block; margin-top: 22rpx;
  font-size: 22rpx; padding: 6rpx 22rpx;
  background: rgba(255,255,255,.2);
  border: 1rpx solid rgba(255,255,255,.35);
  border-radius: 999rpx;
}

/* 正文 */
.body { padding: 32rpx 36rpx 0; }
.lead {
  font-size: 30rpx; line-height: 1.7; color: var(--c-text-1, #333);
  padding: 24rpx 28rpx;
  background: var(--c-surface, #fff);
  border-radius: var(--r-md, 16rpx);
  border-left: 6rpx solid var(--c-primary, #C8161D);
}
.h {
  font-size: 32rpx; font-weight: 700;
  margin: 40rpx 0 18rpx;
  padding-left: 18rpx;
  border-left: 6rpx solid var(--c-primary, #C8161D);
}
.p {
  font-size: 28rpx; line-height: 1.8;
  color: var(--c-text-1, #333);
  margin-bottom: 20rpx;
}
.fact {
  display: flex; gap: 12rpx; align-items: flex-start;
  font-size: 27rpx; line-height: 1.7;
  color: var(--c-text-1, #333);
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--c-divider, #eee);
}
.fact__dot { color: var(--c-primary, #C8161D); font-weight: 800; }
.fact__txt { flex: 1; }

/* 名言 */
.quote {
  position: relative;
  margin: 36rpx 0;
  padding: 36rpx 32rpx 32rpx;
  background: var(--c-surface, #fff);
  border-radius: var(--r-md, 16rpx);
  box-shadow: var(--s-1, 0 4rpx 16rpx rgba(0,0,0,.06));
}
.quote__mark { font-size: 80rpx; color: var(--c-primary, #C8161D); line-height: .5; opacity: .3; }
.quote__txt {
  font-size: 32rpx; font-weight: 700; line-height: 1.7;
  color: var(--c-text-1, #333);
  margin-top: 6rpx;
}

/* 相关宣传片（占位） */
.video-card {
  margin-bottom: 28rpx;
  background: var(--c-surface, #fff);
  border-radius: var(--r-md, 16rpx);
  overflow: hidden;
  box-shadow: var(--s-1, 0 4rpx 16rpx rgba(0,0,0,.06));
}
.video-card__poster {
  position: relative;
  height: 320rpx;
  display: flex; align-items: center; justify-content: center;
}
.video-card__play {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: rgba(255,255,255,.28);
  border: 3rpx solid rgba(255,255,255,.7);
  color: #fff; font-size: 40rpx;
  display: flex; align-items: center; justify-content: center;
}
.video-card__mask {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 14rpx 24rpx;
  font-size: 24rpx; color: #fff;
  background: linear-gradient(180deg, transparent, rgba(0,0,0,.45));
}
.video-card__desc {
  font-size: 25rpx; color: var(--c-text-2, #888);
  padding: 18rpx 24rpx; line-height: 1.6;
}

.empty-page { padding-top: 200rpx; text-align: center; }
.footer-tip { text-align: center; padding: 40rpx 0 10rpx; }

/* 底部操作栏（收藏） */
.action-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; justify-content: center;
  padding: 16rpx 36rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--c-surface, #fff);
  border-top: 1rpx solid var(--c-divider, #eee);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, .04);
  z-index: 10;
}
.action-bar__fav {
  display: flex; align-items: center; gap: 12rpx;
  padding: 16rpx 56rpx;
  border-radius: 999rpx;
  background: var(--c-surface-2, #f2f2f2);
  color: var(--c-text-2, #888);
  font-size: 28rpx; font-weight: 600;
}
.action-bar__fav.on {
  background: rgba(200, 22, 29, .1);
  color: var(--c-primary, #C8161D);
}
.action-bar__icon { font-size: 32rpx; line-height: 1; }
