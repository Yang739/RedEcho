.page { padding: 0 28rpx calc(120rpx + env(safe-area-inset-bottom)); }

/* Hero */
.hero {
  margin: 20rpx 0 8rpx;
  padding: 36rpx 32rpx 32rpx;
  border-radius: var(--r-lg);
  background:
    radial-gradient(120% 120% at 80% 0%, rgba(255,255,255,.12), transparent 60%),
    linear-gradient(135deg, #C8161D 0%, #7A0A10 100%);
  color: #fff;
  box-shadow: var(--s-2);
}
.hero__top { display: flex; align-items: center; justify-content: space-between; }
.hero__greet { font-size: 38rpx; font-weight: 700; }
.hero__sub { font-size: 24rpx; opacity: .82; margin-top: 6rpx; }
.hero__avatar {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,.18);
  font-size: 34rpx; font-weight: 700;
  border: 2rpx solid rgba(255,255,255,.35);
}
.hero__points {
  margin-top: 28rpx;
  display: inline-flex; flex-direction: column;
  padding: 18rpx 28rpx;
  background: rgba(255,255,255,.14);
  border-radius: var(--r-md);
  backdrop-filter: blur(4rpx);
}
.hero__points-num { font-size: 48rpx; font-weight: 800; line-height: 1.1; }
.hero__points-label { font-size: 22rpx; opacity: .85; }

/* 资料分类筛选栏 */
.cat-bar {
  white-space: nowrap;
  margin: 12rpx 0 4rpx;
  padding: 8rpx 0;
}
.cat {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: var(--c-text-2);
  background: var(--c-surface);
  border-radius: var(--r-pill);
  box-shadow: var(--s-1);
}
.cat--on {
  color: #fff;
  background: linear-gradient(135deg, #C8161D 0%, #7A0A10 100%);
  font-weight: 700;
}
.more-link {
  font-size: 24rpx;
  color: var(--c-primary);
  font-weight: 600;
}

/* 推荐卡片 */
.rec {
  display: flex; gap: 22rpx;
  background: var(--c-surface);
  border-radius: var(--r-md);
  padding: 22rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--s-1);
}
.rec__cover {
  position: relative;
  width: 180rpx; height: 180rpx; flex-shrink: 0;
  border-radius: var(--r-sm);
  overflow: hidden;
}
.rec__cover-tag {
  position: absolute; left: 0; top: 0;
  background: rgba(0,0,0,.35); color: #fff;
  font-size: 20rpx; padding: 4rpx 14rpx;
  border-bottom-right-radius: var(--r-sm);
}
.rec__cover-era {
  position: absolute; right: 12rpx; bottom: 8rpx;
  font-size: 52rpx; font-weight: 800; line-height: 1;
  color: rgba(255,255,255,.85);
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,.25);
}
.rec__body { display: flex; flex-direction: column; }
.rec__title { font-size: 32rpx; font-weight: 700; }
.rec__sub { margin-top: 4rpx; }
.rec__desc { margin-top: 8rpx; flex: 1; }
.rec__meta { margin-top: 12rpx; }

/* 阅读进度 */
.trace { display: flex; gap: 20rpx; align-items: center; padding: 14rpx 0; }
.trace + .trace { border-top: 1rpx solid var(--c-divider); }
.trace__cover { width: 88rpx; height: 88rpx; border-radius: var(--r-sm); flex-shrink: 0; }
.trace__bar { margin-top: 12rpx; height: 10rpx; background: var(--c-surface-2); border-radius: var(--r-pill); overflow: hidden; }
.trace__bar-fill { height: 100%; background: linear-gradient(90deg, var(--c-accent), var(--c-primary)); border-radius: var(--r-pill); transition: width .6s cubic-bezier(.16,1,.3,1); }

/* 直播卡片 */
.live {
  display: flex; align-items: center; gap: 20rpx;
  background: var(--c-surface);
  border-radius: var(--r-md);
  padding: 18rpx;
  box-shadow: var(--s-1);
}
.live__cover {
  position: relative; width: 160rpx; height: 120rpx;
  border-radius: var(--r-sm); flex-shrink: 0; overflow: hidden;
}
.live__badge {
  position: absolute; left: 10rpx; bottom: 10rpx;
  display: flex; align-items: center; gap: 8rpx;
  background: rgba(0,0,0,.45); color: #fff;
  font-size: 20rpx; padding: 4rpx 12rpx; border-radius: var(--r-pill);
}
.live__arrow { color: var(--c-primary); font-weight: 700; font-size: 28rpx; }

.footer-tip { text-align: center; padding: 40rpx 0 20rpx; }
