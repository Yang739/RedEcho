.page { padding: 24rpx; min-height: 100vh; background: var(--c-bg); box-sizing: border-box; }

.switch-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 4rpx;
}
.switch-row + .switch-row { border-top: 1rpx solid var(--c-divider); }

.switch-row__main { flex: 1; min-width: 0; padding-right: 20rpx; }
.switch-row__title { font-size: 30rpx; color: var(--c-text); }
.switch-row__desc { font-size: 24rpx; color: var(--c-text-3); margin-top: 4rpx; }

.tip { padding: 24rpx 8rpx; line-height: 1.7; }
