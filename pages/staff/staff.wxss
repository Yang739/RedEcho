.page {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f5f5;
  box-sizing: border-box;
}

.hero { font-size: 36rpx; font-weight: 700; color: #222; padding: 16rpx 8rpx 24rpx; }

.form { background: #fff; border-radius: 16rpx; padding: 24rpx; }
.field { display: flex; align-items: center; padding: 24rpx 8rpx; border-bottom: 1rpx solid #f0f0f0; }
.field__label { width: 120rpx; font-size: 30rpx; color: #333; }
.field__input { flex: 1; font-size: 30rpx; }
.error { color: #C8161D; font-size: 26rpx; margin: 16rpx 8rpx 0; }
.demo { color: #999; font-size: 24rpx; margin: 20rpx 8rpx; line-height: 1.6; }

/* 退出按钮（项目 btn / btn-primary 在 app.wxss 已定义，此处补充 ghost 变体） */
.btn-ghost {
  background: #fff;
  color: #C8161D;
  border: 1rpx solid #C8161D;
  border-radius: 44rpx;
  padding: 22rpx;
  text-align: center;
  font-size: 30rpx;
  margin-top: 32rpx;
}

.staff-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #C8161D, #7A0A10);
  border-radius: 16rpx;
  padding: 32rpx;
  color: #fff;
}
.staff-card__avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.staff-card__name { font-size: 34rpx; font-weight: 600; }
.staff-card__role { font-size: 26rpx; opacity: 0.85; margin-top: 6rpx; }

.tip { font-size: 26rpx; color: #666; padding: 20rpx 8rpx; }

.func { display: flex; align-items: center; padding: 28rpx 8rpx; border-bottom: 1rpx solid #f0f0f0; }
.func:last-child { border-bottom: none; }
.func__body { flex: 1; }
.func__name { font-size: 30rpx; color: #222; }
.func__desc { margin-top: 6rpx; }
.func__arrow { font-size: 32rpx; color: #ccc; }

.footer-tip { text-align: center; margin-top: 40rpx; }
