<view class="page">
  <view class="hero">现场互动</view>
  <view class="sub">现场留言 / 情绪汇聚</view>

  <view wx:if="{{!canPush}}" class="deny">你当前身份无现场互动权限（仅场务 / 管理员可操作）</view>

  <block wx:else>
    <staff-show-selector value="{{showId}}" bind:change="onShowChange" />
    <block wx:if="{{showId}}">
      <view class="section-title">留言上屏</view>
      <re-card title="推送留言">
        <input class="manage__input" placeholder="输入留言内容" value="{{input}}" bindinput="onInput" />
        <view class="btn btn-primary btn-block tap" style="margin-top:20rpx" bindtap="onPushDanmaku">上屏</view>
      </re-card>

      <view class="section-title">情绪上屏</view>
      <re-card title="推送情绪">
        <view class="emo">
          <view wx:for="{{emotions}}" wx:key="id" class="emo__item tap" style="border-color:{{item.color}};color:{{item.color}}" bindtap="onPushEmotion" data-type="{{item.id}}">{{item.label}}</view>
        </view>
      </re-card>

      <view class="section-title">最近留言</view>
      <re-card title="记录">
        <view wx:if="{{!danmaku.length}}" class="empty">暂无留言上屏</view>
        <view wx:for="{{danmaku}}" wx:key="id" class="danmu__item">{{item.text}}</view>
      </re-card>
    </block>
    <view wx:else class="tip">请先在上方选择「正在进行的表演」再上屏</view>
  </block>

  <view class="footer-tip text-3 xs">红韵智演 · 工作人员端</view>
</view>
