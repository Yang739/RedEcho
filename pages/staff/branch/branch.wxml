<view class="page">
  <view class="hero">分支总控</view>
  <view class="sub">锁定本场剧情走向</view>

  <view wx:if="{{!canLock}}" class="deny">你当前身份无分支锁定权限（仅场务 / 管理员可操作）</view>

  <block wx:else>
    <view class="section-title">选择剧情分支</view>
    <re-card title="分支">
      <view class="branch__opts">
        <view wx:for="{{branchOptions}}" wx:key="id" class="branch__opt tap {{choice === item.id ? 'branch__opt--mine' : ''}}" bindtap="onPick" data-id="{{item.id}}">{{item.label}}</view>
      </view>
      <view class="btn btn-primary btn-block tap" style="margin-top:24rpx" bindtap="onLock">锁定</view>
    </re-card>

    <view class="section-title">当前锁定</view>
    <re-card title="状态">
      <view wx:if="{{locked}}" class="locked-text">
        <text class="locked-label">已锁定：</text>
        <text class="locked-val">{{lockedLabel}}</text>
      </view>
      <view wx:else class="empty">尚未锁定分支</view>
    </re-card>

    <view class="tip">锁定后观众端将沿该分支推进剧情。</view>
  </block>

  <view class="footer-tip text-3 xs">红韵智演 · 工作人员端</view>
</view>
