<view class="page">
  <view class="hero">现场通知</view>
  <view class="sub">向现场观众推送场务提示</view>

  <view wx:if="{{!canPush}}" class="deny">你当前身份无通知推送权限（仅场务 / 管理员可操作）</view>

  <block wx:else>
    <staff-show-selector value="{{showId}}" bind:change="onShowChange" />
    <block wx:if="{{showId}}">
      <view class="section-title">发布通知</view>
      <re-card title="推送">
        <textarea class="notice__area" placeholder="输入通知内容" value="{{input}}" bindinput="onInput" maxlength="120" />
        <view class="btn btn-primary btn-block tap" style="margin-top:20rpx" bindtap="onPush">推送通知</view>
      </re-card>

      <view class="section-title">已推送通知</view>
      <re-card title="记录">
        <view wx:if="{{!notices.length}}" class="empty">暂无通知</view>
        <view wx:for="{{notices}}" wx:key="id" class="notice__item">
          <text class="notice__time">{{item.time}}</text>
          <text class="notice__text">{{item.text}}</text>
        </view>
      </re-card>
    </block>
    <view wx:else class="tip">请先在上方选择「正在进行的表演」再发布通知</view>
  </block>

  <view class="footer-tip text-3 xs">红韵智演 · 工作人员端</view>
</view>
