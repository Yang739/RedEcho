.page { padding: 24rpx; min-height: 100vh; background: #f5f5f5; box-sizing: border-box; }
.hero { font-size: 36rpx; font-weight: 700; color: #222; padding: 16rpx 8rpx 12rpx; }
.sub { font-size: 26rpx; color: #999; padding: 0 8rpx 8rpx; }

.deny {
  margin-top: 24rpx; background: #fff; border-radius: 16rpx;
  padding: 28rpx; font-size: 28rpx; color: #C8161D; line-height: 1.6;
}

.section-title { font-size: 30rpx; font-weight: 700; color: #222; padding: 28rpx 8rpx 12rpx; }
.tip { font-size: 24rpx; color: #999; margin-top: 16rpx; }
.footer-tip { text-align: center; margin-top: 40rpx; }
.empty { color: #999; font-size: 26rpx; padding: 20rpx 0; text-align: center; }

.code-display { font-size: 44rpx; font-weight: 800; letter-spacing: 6rpx; color: #C8161D; text-align: center; padding: 20rpx 0; }
.manage__input {
  background: #f5f5f5; border: 1rpx solid #ECE9E4; border-radius: 12rpx;
  padding: 16rpx 20rpx; font-size: 28rpx; box-sizing: border-box;
}
