<view class="page">
  <view class="hero">邀请码</view>
  <view class="sub">设置 / 重置本场演出现场邀请码</view>

  <view wx:if="{{!canSet}}" class="deny">你当前身份无邀请码设置权限（仅场务 / 管理员可操作）</view>

  <block wx:else>
    <staff-show-selector value="{{showId}}" bind:change="onShowChange" />
    <block wx:if="{{showId}}">
      <re-card title="当前邀请码">
        <view wx:if="{{inviteCode}}" class="code-display">{{inviteCode}}</view>
        <view wx:else class="empty">尚未设置邀请码</view>
      </re-card>

      <view class="section-title">设置新邀请码</view>
      <re-card title="修改">
        <input class="manage__input" placeholder="输入邀请码（字母数字）" value="{{input}}" bindinput="onInput" />
        <view class="btn btn-primary btn-block tap" style="margin-top:20rpx" bindtap="onSave">保存</view>
      </re-card>

      <view class="tip">提示：生产环境邀请码应由服务端校验，勿下发到客户端。</view>
    </block>
    <view wx:else class="tip">请先在上方选择「正在进行的表演」再设置邀请码</view>
  </block>

  <view class="footer-tip text-3 xs">红韵智演 · 工作人员端</view>
</view>
