<view class="page">
  <!-- 登录表单（已登录由 staff.js onLoad 自动 reLaunch 到主页） -->
  <view class="hero">工作人员入口</view>
  <view class="sub">场务 / 演员 / 管理员 登录，进入演出管理后台</view>

  <view class="form">
    <view class="field">
      <text class="field__label">手机号</text>
      <input class="field__input" type="number" maxlength="11" placeholder="演示：13700000000" value="{{phone}}" bindinput="onPhone" />
    </view>
    <view class="field">
      <text class="field__label">密码</text>
      <input class="field__input" password placeholder="演示密码 123456" value="{{password}}" bindinput="onPwd" />
    </view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view class="demo">演示账号：13700000000(管理员) / 13800000000(场务) / 13900000000(演员)，密码 123456</view>
    <view class="btn btn-primary btn-block tap" bindtap="onLogin">登录</view>
  </view>

  <view class="footer-tip text-3 xs">红韵智演 · 工作人员端</view>
</view>
