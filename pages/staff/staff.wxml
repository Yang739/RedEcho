<view class="page">
  <!-- 已登录：操作员面板 -->
  <block wx:if="{{isStaff}}">
    <view class="staff-card">
      <view class="staff-card__avatar">{{staff.roleName}}</view>
      <view class="flex-1">
        <view class="staff-card__name">{{staff.name}}</view>
        <view class="staff-card__role">{{staff.roleName}} · {{staff.phone}}</view>
      </view>
    </view>
    <view class="tip">操作人员模式已开启，可进行场务 / 演员相关操作。</view>
    <re-card title="场务 / 演员功能">
      <view class="func tap" wx:for="{{funcs}}" wx:key="key" bindtap="onFunc" data-key="{{item.key}}">
        <view class="func__body">
          <view class="func__name">{{item.name}}</view>
          <view class="func__desc text-3 xs">{{item.desc}}</view>
        </view>
        <text class="func__arrow">›</text>
      </view>
    </re-card>
    <view class="btn btn-ghost btn-block tap" bindtap="onLogout">退出操作人员</view>
  </block>

  <!-- 未登录：操作员登录 -->
  <block wx:else>
    <view class="hero">操作人员入口</view>
    <view class="form">
      <view class="field">
        <text class="field__label">手机号</text>
        <input class="field__input" type="number" maxlength="11" placeholder="演示：13800000000" value="{{phone}}" bindinput="onPhone" />
      </view>
      <view class="field">
        <text class="field__label">密码</text>
        <input class="field__input" password placeholder="演示密码 123456" value="{{password}}" bindinput="onPwd" />
      </view>
      <view wx:if="{{error}}" class="error">{{error}}</view>
      <view class="demo">演示账号：13800000000（场务）/ 13900000000（演员），密码 123456</view>
      <view class="btn btn-primary btn-block tap" bindtap="onLogin">登录</view>
    </view>
  </block>

  <view class="footer-tip text-3 xs">红韵智演 · 工作人员端</view>
</view>
