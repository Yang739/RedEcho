.page { padding: 24rpx; min-height: 100vh; background: #f5f5f5; box-sizing: border-box; }
.hero { font-size: 36rpx; font-weight: 700; color: #222; padding: 16rpx 8rpx 12rpx; }
.sub { font-size: 26rpx; color: #999; padding: 0 8rpx 8rpx; }

.deny {
  margin-top: 24rpx; background: #fff; border-radius: 16rpx;
  padding: 28rpx; font-size: 28rpx; color: #C8161D; line-height: 1.6;
}

.form { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-top: 24rpx; }
.field { display: flex; align-items: center; padding: 24rpx 8rpx; border-bottom: 1rpx solid #f0f0f0; }
.field__label { width: 120rpx; font-size: 30rpx; color: #333; }
.field__input { flex: 1; font-size: 30rpx; letter-spacing: 2rpx; }
.btn-row { display: flex; gap: 20rpx; margin-top: 24rpx; }
.btn-row .btn { flex: 1; }

.result { margin-top: 24rpx; border-radius: 16rpx; padding: 28rpx; }
.result--ok { background: #eaf7ee; }
.result--fail { background: #fdecec; }
.result__title { font-size: 32rpx; font-weight: 700; margin-bottom: 12rpx; }
.result--ok .result__title { color: #1a9c4b; }
.result--fail .result__title { color: #C8161D; }
.result__line { font-size: 27rpx; color: #333; padding: 4rpx 0; }

.section-title { font-size: 30rpx; font-weight: 700; color: #222; padding: 28rpx 8rpx 12rpx; }
.orders { background: #fff; border-radius: 16rpx; padding: 8rpx 24rpx; }
.order { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.order:last-child { border-bottom: none; }
.order__cover { width: 88rpx; height: 88rpx; border-radius: 12rpx; margin-right: 20rpx; flex-shrink: 0; }
.order__title { font-size: 30rpx; font-weight: 600; color: #222; }
.order__arrow { color: #ccc; font-size: 32rpx; }

.footer-tip { text-align: center; margin-top: 40rpx; }
.empty { color: #999; font-size: 26rpx; padding: 20rpx 0; text-align: center; }
