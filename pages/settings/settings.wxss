.page {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f5f5;
  box-sizing: border-box;
}

.profile {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.profile__avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #C8161D, #7A0A10);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.profile__name { font-size: 34rpx; font-weight: 600; color: #222; }
.profile__sub { font-size: 26rpx; color: #999; margin-top: 6rpx; }

re-card { display: block; margin-bottom: 24rpx; }

.row {
  display: flex;
  align-items: center;
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.row:last-child { border-bottom: none; }
.row__label { flex: 1; font-size: 30rpx; color: #222; }
.row__val { font-size: 26rpx; color: #999; margin-right: 8rpx; }
.row__arrow { font-size: 32rpx; color: #ccc; }

.footer-tip { text-align: center; margin-top: 40rpx; }
