<view class="page">
  <re-card title="我的阅读">
    <view class="read-head">
      <text class="read-count text-3 xs">已读 {{count}} 篇</text>
      <text wx:if="{{list.length}}" class="read-clear" bindtap="onClear">清空</text>
    </view>
    <view wx:if="{{list.length}}" class="read-list">
      <view
        class="read-item tap"
        wx:for="{{list}}"
        wx:key="id"
        bindtap="onRead"
        data-id="{{item.id}}"
      >
        <view class="read-item__bar" style="background:{{item.gradient}}"></view>
        <view class="read-item__main">
          <view class="read-item__title">{{item.title}}</view>
          <view class="read-item__sub text-3 xs">{{item.catName}} · {{item.subtitle}}</view>
        </view>
        <text class="read-item__arrow">›</text>
      </view>
    </view>
    <view wx:else class="read-empty text-3 xs">还没有阅读记录，去首页看看资料卡片吧</view>
  </re-card>

  <view class="footer-tip text-3 xs">红色回响 · 红色旧址沉浸式互动演出</view>
</view>
