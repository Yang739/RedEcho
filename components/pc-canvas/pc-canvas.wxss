.cv {
  width: 100%;
  height: 100%;
  display: block;
}

/* 横版卡片顺时针旋转 90°：在竖版(2:3) 框内等大呈现（与竖版一致）。
   画布背存仍为 3:2（横版原比例），旋转后视觉上 2:3 恰好填满 .pc-frame。 */
.cv--rot {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 150%;
  height: auto;
  aspect-ratio: 3 / 2;
  transform: translate(-50%, -50%) rotate(90deg);
}
