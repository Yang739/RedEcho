.page { padding: 20rpx 28rpx 60rpx; }
.intro { padding: 8rpx 4rpx 16rpx; }
.intro__title { font-size: 36rpx; font-weight: 800; }
.intro__desc { font-size: 25rpx; color: var(--c-text-2); margin-top: 8rpx; }

/* 结果卡片 */
.pc-card {
  height: 760rpx; border-radius: var(--r-lg);
  box-shadow: var(--s-2); overflow: hidden; background: var(--c-surface-2);
}
.pc-card__img { width: 100%; height: 100%; display: block; }
.pc-card__inner {
  height: 100%; padding: 48rpx 40rpx;
  display: flex; flex-direction: column; justify-content: space-between; color: #fff;
}
.pc-card__scene { font-size: 40rpx; font-weight: 800; letter-spacing: 1rpx; }
.pc-card__quote { font-size: 38rpx; line-height: 1.7; font-style: italic; font-weight: 600; }
.pc-card__date { font-size: 24rpx; opacity: .85; }
.pc-actions { margin-top: 28rpx; display: flex; flex-direction: column; gap: 18rpx; }

/* 离屏画布 */
.pc-canvas { position: fixed; left: -9999rpx; top: -9999rpx; width: 600px; height: 800px; }

/* 场景选择 */
.scenes { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.scene { background: var(--c-surface); border-radius: var(--r-md); overflow: hidden; box-shadow: var(--s-1); }
.scene__cover { height: 200rpx; }
.scene__name { font-size: 28rpx; font-weight: 700; padding: 16rpx 20rpx 4rpx; }
.scene__desc { padding: 0 20rpx 20rpx; }

/* 生成遮罩 */
.gen-mask {
  position: fixed; inset: 0; z-index: 50;
  background: rgba(0,0,0,.45);
  display: flex; align-items: center; justify-content: center;
}
.gen-box {
  background: #fff; border-radius: var(--r-lg);
  padding: 56rpx 64rpx; display: flex; flex-direction: column; align-items: center;
}
.gen-spinner {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  border: 8rpx solid var(--c-primary-light);
  border-top-color: var(--c-primary);
}
.gen-text { margin-top: 28rpx; font-size: 28rpx; color: var(--c-text); font-weight: 600; }
