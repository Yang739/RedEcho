.page { padding: 20rpx 28rpx 40rpx; }
.intro { padding: 8rpx 4rpx 16rpx; }
.intro__title { font-size: 36rpx; font-weight: 800; }
.intro__desc { font-size: 25rpx; color: var(--c-text-2); margin-top: 8rpx; line-height: 1.6; }

/* 预览 / 结果容器：舞台外观由共享 .pc-stage 提供（限定最大宽、柔和底衬、居中） */
.preview { /* 实时预览外层；.pc-stage 已处理最大宽与居中 */ }
.result { max-width: 560rpx; margin: 0 auto; }

/* 选项选择（方向 / 排列 / 字体 共用） */
.opts { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.opt {
  background: var(--c-surface); border-radius: var(--r-md);
  padding: 22rpx 18rpx; text-align: center;
  border: 3rpx solid transparent; box-shadow: var(--s-1);
  box-sizing: border-box;
}
.opt--on { border-color: var(--c-primary, #C8161D); background: rgba(200,22,29,.06); }
.opt__name { font-size: 28rpx; font-weight: 700; }
.opt__desc { margin-top: 6rpx; }

/* 结果卡片动作区 */
.result-actions { margin-top: 24rpx; }
/* 保存/分享/打印：三等分（用中间按钮 margin 代替容器 gap，
   避免 gap 吃掉宽度导致比「再生成一张」窄） */
.pc-actions-3 { display: flex; }
.pc-actions-3 .btn {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
}
.pc-actions-3 .pc-actions-gap { margin: 0 14rpx; }
/* 「再生成一张」做成与上方同宽的 flex 行，保证两行严格对齐 */
.pc-actions2 { margin-top: 16rpx; display: flex; }
.pc-actions2 .btn { flex: 1; }
.pc-share { line-height: 1; padding: 0; margin: 0; }
.pc-share::after { border: none; }

/* 名言位置 3x3 宫格 */
.pos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.pos {
  background: var(--c-surface); border-radius: var(--r-md);
  padding: 20rpx 0; text-align: center; font-size: 26rpx; font-weight: 700;
  border: 3rpx solid transparent; box-shadow: var(--s-1); box-sizing: border-box;
}
.pos--on { border-color: var(--c-primary, #C8161D); background: rgba(200,22,29,.06); color: var(--c-primary, #C8161D); }

/* 离屏画布 */
.pc-canvas { position: fixed; left: -9999rpx; top: -9999rpx; width: 900px; height: 600px; }

/* 场景选择：单行左右滑动 */
.scenes {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  gap: 18rpx;
  padding-bottom: 10rpx;
  -webkit-overflow-scrolling: touch;
  scroll-snap-type: x proximity;
}
.scenes::-webkit-scrollbar { display: none; }
.scene {
  flex: 0 0 auto;
  width: 250rpx;
  scroll-snap-align: start;
  background: var(--c-surface); border-radius: var(--r-md); overflow: hidden;
  box-shadow: var(--s-1); border: 3rpx solid transparent; box-sizing: border-box;
}
.scene--on { border-color: var(--c-primary, #C8161D); }
.scene__cover { height: 160rpx; }
.scene__name { font-size: 27rpx; font-weight: 700; padding: 14rpx 18rpx 4rpx; }
.scene__desc { padding: 0 18rpx 16rpx; }

/* 金句输入 */
.quote-input {
  width: 100%; box-sizing: border-box;
  min-height: 120rpx; padding: 20rpx 24rpx;
  font-size: 28rpx; line-height: 1.6; color: var(--c-text);
  background: var(--c-surface); border-radius: var(--r-md);
  border: 1rpx solid var(--c-divider, #eee);
}
.presets { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 16rpx; }
.preset {
  font-size: 24rpx; color: var(--c-text-2);
  padding: 10rpx 18rpx; background: var(--c-surface-2);
  border-radius: var(--r-pill); border: 1rpx solid var(--c-divider, #eee);
}
.preset:active { color: var(--c-primary, #C8161D); border-color: var(--c-primary, #C8161D); }

.gen-btn { margin-top: 36rpx; }

/* 生成遮罩 */
.gen-mask {
  position: fixed; inset: 0; z-index: 50;
  background: rgba(0,0,0,.45);
  display: flex; align-items: center; justify-content: center;
}
.gen-box {
  background: #fff; border-radius: var(--r-lg);
  padding: 56rpx 64rpx; display: flex; flex-direction: column; align-items: center;
}
.gen-spinner {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  border: 8rpx solid var(--c-primary-light);
  border-top-color: var(--c-primary);
}
.gen-text { margin-top: 28rpx; font-size: 28rpx; color: var(--c-text); font-weight: 600; }
