<view class="page">
  <view class="intro">
    <view class="intro__title">生成你的红色明信片</view>
    <view class="intro__desc">AI 将依据场景为你生成专属金句，可一键保存至相册。</view>
  </view>

  <!-- 结果 -->
  <block wx:if="{{result}}">
    <view class="pc-card fade-up">
      <image wx:if="{{useImage}}" class="pc-card__img" src="{{result.imageUrl}}" mode="aspectFill" />
      <view wx:else class="pc-card__inner" style="background:{{result.gradient}}">
        <view class="pc-card__scene">{{result.scene}}</view>
        <view class="pc-card__quote">“{{result.quote}}”</view>
        <view class="pc-card__date">{{result.date}} · 红色回响</view>
      </view>
    </view>
    <view class="pc-actions">
      <view class="btn btn-primary btn-block tap" bindtap="onSave">保存相册</view>
      <view class="btn btn-ghost btn-block tap" bindtap="onAgain">再生成一张</view>
    </view>
    <!-- 离屏画布：用于 CSS 模式下导出图片（透明不占视觉） -->
    <canvas type="2d" id="pcCanvas" class="pc-canvas"></canvas>
  </block>

  <!-- 选择 -->
  <block wx:else>
    <view class="section-title">选择场景</view>
    <view class="scenes">
      <view
        class="scene tap"
        wx:for="{{scenes}}"
        wx:key="id"
        bindtap="onSelect"
        data-id="{{item.id}}"
      >
        <view class="scene__cover" style="background:{{item.gradient}}"></view>
        <view class="scene__name">{{item.name}}</view>
        <view class="scene__desc text-3 xs ellipsis">{{item.desc}}</view>
      </view>
    </view>
  </block>

  <!-- 生成中遮罩 -->
  <view wx:if="{{generating}}" class="gen-mask">
    <view class="gen-box">
      <view class="gen-spinner spin"></view>
      <view class="gen-text">AI 正在生成明信片…</view>
    </view>
  </view>
</view>
