<view class="page">
  <view class="rv-hero" style="background:{{show.gradient}}">
    <view class="rv-hero__mask"></view>
    <view class="rv-hero__inner">
      <view class="rv-hero__title">{{show.title}}</view>
      <view class="rv-hero__sub">{{show.venue}} · {{show.date}}</view>
    </view>
  </view>

  <re-card title="我的投票">
    <view class="rv-vote">
      <re-tag type="primary" solid>已选</re-tag>
      <text class="subtitle">{{myVote}}</text>
    </view>
  </re-card>

  <re-card title="现场情绪分布">
    <view class="emo-bar" wx:for="{{emotionDist}}" wx:key="label">
      <text class="emo-bar__label">{{item.label}}</text>
      <view class="emo-bar__track"><view class="emo-bar__fill" style="width:{{item.pct}}%"></view></view>
      <text class="emo-bar__pct">{{item.pct}}%</text>
    </view>
  </re-card>

  <re-card title="本场金句">
    <view class="rv-quote">“{{quote}}”</view>
  </re-card>

  <view class="btn btn-primary btn-block tap rv-cta" bindtap="goGenerate">把这份感动做成明信片 ›</view>
  <view style="height:40rpx"></view>
</view>
