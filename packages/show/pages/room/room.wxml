<view class="room">
  <!-- 头部 -->
  <view class="room__hero" style="background:{{show.gradient}}">
    <view class="room__hero-mask"></view>
    <view class="room__hero-inner">
      <view class="between">
        <view class="room__title ellipsis">{{show.title}}</view>
        <view wx:if="{{show.status === 'live'}}" class="live__badge">
          <view class="live-dot"></view><text>直播中</text>
        </view>
      </view>
      <view class="room__seg">{{show.segment}} · {{show.online}} 人在线</view>
    </view>
  </view>

  <scroll-view scroll-y class="room__body" enhanced show-scrollbar="{{false}}">

    <!-- 已结束横幅 -->
    <view wx:if="{{statusBanner}}" class="room__banner">{{statusBanner}}</view>

    <!-- 即将开始：仅展示详情与开始时间，不含任何互动功能 -->
    <block wx:if="{{isUpcoming}}">
      <re-card title="演出信息">
        <view class="up-row"><text class="up-label">演出名称</text><text class="up-val">{{show.title}}</text></view>
        <view class="up-row"><text class="up-label">演出地点</text><text class="up-val">{{show.venue}}</text></view>
        <view class="up-row"><text class="up-label">开始时间</text><text class="up-time">{{show.date}}</text></view>
      </re-card>
      <view class="room__banner">演出尚未开始，开场前请留意现场通知</view>
    </block>

    <!-- 邀请码核验：直播中且尚未解锁 -->
    <re-card wx:if="{{gateNeeded}}" title="演出现场邀请码">
      <view class="invite__hint">本场互动需核验演出现场邀请码。邀请码由现场工作人员或舞台大屏给出，请在现场获取后输入。</view>
      <view class="invite__row">
        <input
          class="invite__input"
          placeholder="请输入邀请码"
          value="{{inviteInput}}"
          bindinput="onInviteInput"
          confirm-type="done"
          bindconfirm="onUnlock"
        />
        <view class="invite__btn btn btn-primary btn-sm tap {{inviteInput ? '' : 'invite__btn--off'}}" bindtap="onUnlock">解锁</view>
      </view>
      <view wx:if="{{inviteError}}" class="invite__err">{{inviteError}}</view>
    </re-card>

    <!-- 互动区：直播中 且 已解锁（未开始 / 已结束不渲染） -->
    <block wx:if="{{!gateNeeded && isLive}}">

      <!-- 实时投票 -->
      <re-card title="剧情投票" wx:if="{{show.pollOpen}}">
        <view slot="extra" wx:if="{{voted}}" class="text-3 xs">已投票</view>
        <view class="poll__q">{{poll.question}}</view>
        <view class="poll__opts">
          <view
            wx:for="{{poll.options}}"
            wx:key="id"
            class="poll__opt tap {{voted ? 'poll__opt--done' : ''}} {{voted === item.id ? 'poll__opt--mine' : ''}}"
            bindtap="onVote"
            data-id="{{item.id}}"
          >
            <view class="poll__bar" style="width:{{item.pct}}%"></view>
            <view class="poll__label">
              <text>{{item.label}}</text>
              <text class="poll__pct">{{item.pct}}%</text>
            </view>
          </view>
        </view>
        <view class="tip">实时结果随现场票情滚动更新</view>
      </re-card>

      <!-- 情绪反馈 -->
      <re-card title="此刻心情">
        <view class="emo">
          <view
            wx:for="{{emotions}}"
            wx:key="id"
            class="emo__item tap {{selectedEmotion === item.id ? 'emo__item--on' : ''}}"
            style="{{selectedEmotion === item.id ? 'border-color:' + item.color + ';color:' + item.color : ''}}"
            bindtap="onEmotion"
            data-id="{{item.id}}"
          >{{item.label}}</view>
        </view>
      </re-card>

      <!-- 剧情分支 -->
      <re-card title="剧情分支">
        <view class="branch__text">{{branch.text}}</view>
        <view class="branch__opts">
          <view
            wx:for="{{branch.options}}"
            wx:key="id"
            class="branch__opt tap {{branchChoice ? 'branch__opt--done' : ''}} {{branchChoice === item.id ? 'branch__opt--mine' : ''}}"
            bindtap="onBranch"
            data-id="{{item.id}}"
          >{{item.label}}</view>
        </view>
        <view class="branch__state">
          <re-tag type="primary" solid>{{branchChoice ? '已选定' : '进行中'}}</re-tag>
          <text class="text-3 sm">{{branchChoice ? branchChoiceLabel : branch.current}}</text>
        </view>
      </re-card>

      <!-- 现场实时 -->
      <re-card title="现场实时">
        <view class="notice">
          <view wx:for="{{notices}}" wx:key="id" class="notice__item fade-up">
            <text class="notice__time">{{item.time}}</text>
            <text class="notice__text">{{item.text}}</text>
          </view>
        </view>
      </re-card>

      <!-- 弹幕 -->
      <re-card title="实时弹幕">
        <view class="danmu">
          <view wx:for="{{messages}}" wx:key="id" class="danmu__item">{{item.text}}</view>
          <view wx:if="{{!messages.length}}" class="empty">还没有弹幕，来发第一条吧</view>
        </view>
        <view wx:if="{{isEnded}}" class="room__cta btn btn-ghost btn-block tap" bindtap="goReview">查看本场回顾 ›</view>
      </re-card>

      <view style="height:30rpx"></view>
    </block>
  </scroll-view>

  <!-- 底部弹幕输入：仅直播中已解锁时显示 -->
  <view class="room__foot" wx:if="{{!gateNeeded && isLive}}" style="padding-bottom:calc(16rpx + var(--safe-bottom))">
    <input
      class="room__input"
      placeholder="发条弹幕，与现场共鸣…"
      value="{{inputValue}}"
      bindinput="onInput"
      confirm-type="send"
      bindconfirm="onSend"
    />
    <view class="room__send btn btn-primary btn-sm tap" bindtap="onSend">发送</view>
  </view>
</view>
