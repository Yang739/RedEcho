.room { display: flex; flex-direction: column; height: 100vh; width: 100%; box-sizing: border-box; overflow: hidden; background: var(--c-bg); }
.room__hero { position: relative; padding: 40rpx 32rpx 36rpx; width: 100%; box-sizing: border-box; }
.room__hero-mask {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,.05), rgba(0,0,0,.28));
}
.room__hero-inner { position: relative; color: #fff; width: 100%; box-sizing: border-box; }
.room__title { font-size: 36rpx; font-weight: 700; max-width: 480rpx; }
.room__seg { font-size: 24rpx; opacity: .88; margin-top: 10rpx; }

.room__body { flex: 1; width: 100%; box-sizing: border-box; padding: 24rpx 28rpx 0; }

/* 未开始：演出信息行 */
.up-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; }
.up-row + .up-row { border-top: 2rpx solid var(--c-divider); }
.up-label { font-size: 26rpx; color: var(--c-text-3); flex-shrink: 0; }
.up-val { font-size: 28rpx; font-weight: 600; color: var(--c-text); text-align: right; }
.up-time { font-size: 30rpx; font-weight: 700; color: var(--c-primary); text-align: right; }

/* 投票 */
.poll__q { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.poll__opts { display: flex; flex-direction: column; gap: 16rpx; }
.poll__opt {
  position: relative; overflow: hidden;
  border: 2rpx solid var(--c-border);
  border-radius: var(--r-md);
  padding: 24rpx 28rpx;
  background: var(--c-surface);
}
.poll__opt--done { border-color: transparent; }
.poll__opt--mine { border-color: var(--c-primary); }
.poll__bar {
  position: absolute; left: 0; top: 0; bottom: 0;
  background: linear-gradient(90deg, rgba(232,163,61,.30), rgba(200,22,29,.22));
  transition: width .6s cubic-bezier(.16,1,.3,1);
}
.poll__opt--mine .poll__bar { background: linear-gradient(90deg, rgba(200,22,29,.28), rgba(200,22,29,.14)); }
.poll__label {
  position: relative; display: flex; justify-content: space-between;
  font-size: 28rpx; font-weight: 600;
}
.poll__pct { color: var(--c-primary); }

/* 情绪 */
.emo { display: flex; flex-wrap: wrap; gap: 16rpx; }
.emo__item {
  padding: 14rpx 30rpx; border-radius: var(--r-pill);
  border: 2rpx solid var(--c-border);
  font-size: 26rpx; font-weight: 600; color: var(--c-text-2);
  background: var(--c-surface);
}
.emo__item--on { background: var(--c-surface); font-weight: 700; }

/* 分支 */
.branch__text { font-size: 28rpx; line-height: 1.7; color: var(--c-text); }
.branch__state { display: flex; align-items: center; gap: 14rpx; margin-top: 18rpx; }

/* 通知 */
.notice { display: flex; flex-direction: column; gap: 14rpx; }
.notice__item { display: flex; gap: 16rpx; font-size: 26rpx; }
.notice__time { color: var(--c-text-3); flex-shrink: 0; }

/* 弹幕 */
.danmu { display: flex; flex-direction: column; gap: 12rpx; }
.danmu__item {
  align-self: flex-start;
  background: var(--c-surface-2);
  padding: 12rpx 22rpx; border-radius: var(--r-pill);
  font-size: 26rpx; max-width: 90%;
}
.room__cta { margin-top: 24rpx; }

/* 状态横幅（即将开始 / 已落幕） */
.room__banner {
  margin-bottom: 24rpx;
  padding: 20rpx 28rpx;
  background: var(--c-surface);
  border-radius: var(--r-md);
  font-size: 26rpx; font-weight: 600; color: var(--c-text-2);
  box-shadow: var(--s-1);
}

/* 底部输入 */
.room__foot {
  display: flex; align-items: center; gap: 16rpx;
  width: 100%; box-sizing: border-box;
  padding: 16rpx 28rpx;
  background: var(--c-surface);
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.05);
}
.room__input {
  flex: 1; height: 72rpx; padding: 0 28rpx;
  background: var(--c-surface-2); border-radius: var(--r-pill);
  font-size: 28rpx;
}
.room__send { height: 72rpx; }

/* 邀请码核验 */
.invite__hint { font-size: 26rpx; color: var(--c-text-2); line-height: 1.6; margin-bottom: 24rpx; }
.invite__row { display: flex; align-items: center; gap: 16rpx; }
.invite__input {
  flex: 1; height: 80rpx; padding: 0 28rpx;
  background: var(--c-surface-2); border-radius: var(--r-md);
  font-size: 30rpx; letter-spacing: 2rpx;
}
.invite__btn { height: 80rpx; min-width: 150rpx; display: flex; align-items: center; justify-content: center; }
.invite__btn--off { opacity: .45; }
.invite__err { margin-top: 16rpx; font-size: 24rpx; color: #E23744; }
