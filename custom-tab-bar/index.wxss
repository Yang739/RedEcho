/* 细线强调式导航栏 · 与 design/navbar.html 一致
   静默=暖灰 #8C8782；点击=2px 红线条(#C8161D)从中心展开；活跃=墨黑 #1F1D1B + 红线条常驻 */

.tab-bar {
  position: relative;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #E7E3DD;        /* 细线分隔 */
  padding-bottom: env(safe-area-inset-bottom);
}

.tab {
  flex: 1;
  min-height: 110rpx;                      /* ≥44px 触控目标（rpx 适配） */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 12rpx 0;
  color: #8C8782;                          /* 静默灰（标签文字） */
  position: relative;
  overflow: hidden;
  transition: color .2s ease, background-color .18s ease;
}

.tab__icon {
  width: 44rpx;
  height: 44rpx;
}

.tab__label {
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 1;
}

/* —— 红色线条：默认隐藏，活跃 / 按下时从中心展开 —— */
.tab::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 56rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #C8161D;                     /* 品牌红 */
  transform: translateX(-50%) scaleX(0);
  transition: transform .26s cubic-bezier(.22, 1, .36, 1);
}

/* 活跃态：墨黑文字 + 常驻红线条（图标由 wxml 切换为 ink svg） */
.tab--active { color: #1F1D1B; }
.tab--active::after { transform: translateX(-50%) scaleX(1); }

/* 点击瞬间：红线条展开（点击效果=红色线条），文字仍静默灰 */
.tab--press { background-color: rgba(31, 29, 27, .03); }
.tab--press::after { transform: translateX(-50%) scaleX(1); }
